# Optional: email every booking request to the shop (https://resend.com, free tier is enough).
# Without these, the form hands the customer a pre-filled text message to (915) 920-5204 instead.
RESEND_API_KEY=
BOOKING_EMAIL_TO=
# Must be a sender on a domain verified in Resend, e.g. "Legends Website <booking@yourdomain.com>"
BOOKING_EMAIL_FROM=
